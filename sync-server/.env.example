PORT=1234
# Must match Spring Boot codeit.jwt.secret
CODEIT_JWT_SECRET=1234567891011121314151617181920212223242526272829303132

# Yjs WebSocket connection caps
MAX_WS_CONNECTIONS=200
MAX_WS_PER_ROOM=40
MAX_WS_PER_DOC=20
# Max browser tabs per user (each tab opens :code + :whiteboard)
MAX_TABS_PER_USER=2

# Heartbeat / idle (default 4 minutes)
WS_IDLE_TIMEOUT_MS=240000
WS_PING_INTERVAL_MS=30000

# Cap Yjs / whiteboard update frames (256 KiB)
MAX_WS_MESSAGE_BYTES=262144

# Whiteboard draw rate (messages per window per user per room)
WB_MSG_LIMIT=40
WB_MSG_WINDOW_MS=1000
