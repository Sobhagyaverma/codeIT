# Same-origin (recommended): leave both empty.
# - Dev: Vite proxies /api+/ws → :9091 and /sync → :1234
# - Prod: Nginx serves the SPA and proxies /api, /ws, /sync
#
# Or set absolute URLs (API requires CORS allowlist):
# VITE_API_URL=http://localhost:9091
# VITE_SYNC_WS_URL=ws://localhost:1234
VITE_API_URL=
VITE_SYNC_WS_URL=
