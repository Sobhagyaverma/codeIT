# Copy to .env and fill before `docker compose up -d --build`
# Never commit real secrets.
#
# Homelab + Supabase (recommended on the VM):
#   docker compose -f docker-compose.yml -f docker-compose.supabase.yml up -d --build
# Local Postgres in compose (default stack):
#   docker compose up -d --build

HTTP_PORT=80

# --- Postgres ---
# A) Local compose postgres (docker-compose.yml only):
POSTGRES_DB=codeit
POSTGRES_USER=codeit
POSTGRES_PASSWORD=change-me-strong-db-password

# B) Supabase (docker-compose.supabase.yml) — required when using that override.
# Use Session pooler host when the VM is IPv4-only. Escape is not needed in .env.
# SPRING_DATASOURCE_URL=jdbc:postgresql://aws-1-REGION.pooler.supabase.com:5432/postgres?sslmode=require
# SPRING_DATASOURCE_USERNAME=postgres.YOUR_PROJECT_REF
# SPRING_DATASOURCE_PASSWORD=

# CodeIT's own Redis (compose service `redis`) — do NOT point at Judge0's Redis.
REDIS_PASSWORD=change-me-strong-redis-password

# Spring profile inside the API container (compose sets this; do not use `local` on the VM)
# SPRING_PROFILES_ACTIVE=prod

# Must match between API and sync-server (>= 32 chars, not the repo default)
CODEIT_JWT_SECRET=change-me-to-a-long-random-jwt-secret-value
CODEIT_OTP_PEPPER=change-me-otp-pepper-16plus
# Optional; defaults to CODEIT_OTP_PEPPER when unset
# CODEIT_INVITE_PEPPER=
# Shared secret for API → sync revoke (kick/leave/archive)
SYNC_INTERNAL_SECRET=change-me-sync-internal-secret

# Public site URL (invite emails, absolute links). Same-origin SPA behind Nginx/Cloudflare:
CODEIT_PUBLIC_BASE_URL=https://codeit.example.com
# OPEN | INVITE_ONLY | COLLEGE_ONLY
CODEIT_REGISTRATION_MODE=INVITE_ONLY

# Browser origin(s) hitting the API (comma-separated). Same-origin SPA:
#   CODEIT_CORS_ORIGINS=https://codeit.example.com
# Local compose on :80:
CODEIT_CORS_ORIGINS=http://localhost,http://127.0.0.1

# Cloudflare Turnstile (required in prod profile)
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Judge0 on the same host / homelab (NOT in this compose, NOT public).
# Firewall: only the VPS/API host may reach :2358. Never publish Judge0 via Cloudflare.
JUDGE0_API_URL=http://host.docker.internal:2358

# Optional AI / mail
GROQ_API_KEY=
CODEIT_MAIL_ENABLED=false
CODEIT_MAIL_FROM=
CODEIT_MAIL_INBOX=
SPRING_MAIL_USERNAME=
BREVO_SMTP_KEY=

# JVM heap for the API container
API_JAVA_OPTS=-XX:MaxRAMPercentage=75.0 -Xmx512m
