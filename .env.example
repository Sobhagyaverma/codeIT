# Copy to .env and fill before `docker compose up -d --build`
# Never commit real secrets.

HTTP_PORT=80

POSTGRES_DB=codeit
POSTGRES_USER=codeit
POSTGRES_PASSWORD=change-me-strong-db-password
REDIS_PASSWORD=change-me-strong-redis-password

# Must match between API and sync-server (>= 32 chars, not the repo default)
CODEIT_JWT_SECRET=change-me-to-a-long-random-jwt-secret-value
CODEIT_OTP_PEPPER=change-me-otp-pepper-16plus
# Shared secret for API → sync revoke (kick/leave/archive)
SYNC_INTERNAL_SECRET=change-me-sync-internal-secret

# Browser origin(s) hitting the API (comma-separated). Same-origin SPA:
#   CODEIT_CORS_ORIGINS=https://codeit.example.com
# Local compose on :80:
CODEIT_CORS_ORIGINS=http://localhost,http://127.0.0.1

# Cloudflare Turnstile (required in prod profile)
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Judge0 on homelab / host (NOT in this compose, NOT public).
# Firewall: only the VPS/API host may reach :2358. Never publish Judge0 via Cloudflare.
JUDGE0_API_URL=http://host.docker.internal:2358

# Optional
GROQ_API_KEY=
CODEIT_MAIL_ENABLED=false
CODEIT_MAIL_FROM=
CODEIT_MAIL_INBOX=
SPRING_MAIL_USERNAME=
BREVO_SMTP_KEY=

# JVM heap for the API container
API_JAVA_OPTS=-XX:MaxRAMPercentage=75.0 -Xmx512m
